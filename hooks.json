{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __GENIE_DIR__/router/genie_router.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|apply_patch|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __GENIE_DIR__/router/guard_dangerous.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
